    flex-grow: 1;
    padding-top: 24px;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.inventory-section {
    width: 100%;
    min-height: 420px;
    padding-top: 12px;
    padding-right: 18px;
    padding-bottom: 14px;
    padding-left: 18px;
    margin-top: 8px;
    margin-right: 1%;
    margin-bottom: 8px;
    margin-left: 1%;
    background-color: var(--surface-panel-soft);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
}

.inventory-footer {
    height: 82px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.inventory-page-button {
    width: 72px;
    height: 72px;
    background-color: rgba(255, 255, 255, 0);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    padding-top: 14px;
    padding-right: 14px;
    padding-bottom: 14px;
    padding-left: 14px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
}

.inventory-page-button:active {
    background-color: rgba(255, 255, 255, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.inventory-page-button:disabled {
    opacity: 0.35;
}

.inventory-page-previous-button {
    background-image: url("project://database/Assets/View/UI/Sprites/Icons/Icon-SolidArrow-Left-Idle.png?fileID=21300000&guid=3885c407db79bf9a0f14b5ac8ebfcd98&type=3#Icon-SolidArrow-Left-Idle");
}

.inventory-page-previous-button:active {
    background-image: url("project://database/Assets/View/UI/Sprites/Icons/Icon-SolidArrow-Left-Click.png?fileID=21300000&guid=4b2ca7c3baefb8d0dfa1f2aa42c904e9&type=3#Icon-SolidArrow-Left-Click");
}

.inventory-page-next-button {
    background-image: url("project://database/Assets/View/UI/Sprites/Icons/Icon-SolidArrow-Right-Idle.png?fileID=21300000&guid=b99712368a6e08301172bae7266d67cf&type=3#Icon-SolidArrow-Right-Idle");
}

.inventory-page-next-button:active {
    background-image: url("project://database/Assets/View/UI/Sprites/Icons/Icon-SolidArrow-Right-Click.png?fileID=21300000&guid=d14f50149b1ffec865b6dac28ca7c615&type=3#Icon-SolidArrow-Right-Click");
}

.inventory-page-text {
    width: 360px;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 36px;
    color: var(--text-on-panel);
    -unity-text-align: middle-center;
}

.inventory-section-title {
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 36px;
    color: var(--text-on-panel);
    white-space: normal;
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: var(--text-on-panel);
}

.inventory-detail {
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    font-size: 32px;
    color: var(--play-panel-deep);
    white-space: normal;
}

.inventory-input-blocker {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--scrim-tipis);
}

.pause-input-blocker {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--scrim-sedang);
}

.pause-panel {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 620px;
    height: 380px;
    padding-top: 42px;
    padding-right: 42px;
    padding-bottom: 42px;
    padding-left: 42px;
    justify-content: center;
    align-items: center;
    background-color: var(--surface-panel);
    border-top-left-radius: 36px;
    border-top-right-radius: 36px;
    border-bottom-right-radius: 36px;
    border-bottom-left-radius: 36px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: var(--play-line);
    border-right-color: var(--play-line);
    border-top-color: var(--play-line);
    border-bottom-color: var(--play-line);
    translate: -50% -260%;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}

.show-pause-panel {
    translate: -50% -50%;
    opacity: 1;
}

.exit-confirm-panel {
    width: 900px;
    height: auto;
    min-height: 340px;
    padding-left: 56px;
    padding-right: 56px;
}

.exit-confirm-title {
    font-size: 56px;
    white-space: normal;
    margin-bottom: 34px;
}

.exit-confirm-button {
    width: 220px;
    height: 88px;
    margin-left: 18px;
    margin-right: 18px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/View/UI/Sprites/Icons/Button-Idle.png?fileID=21300000&guid=eb7df812497e1784eed21e2d0c3d59aa&type=3#Button-Idle");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 36px;
    color: var(--text-on-panel);
    -unity-text-align: middle-center;
    white-space: nowrap;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
}

.exit-confirm-button:active {
    background-image: url("project://database/Assets/View/UI/Sprites/Icons/Button-Click.png?fileID=21300000&guid=02413f5eb0cc0c4b5d9cf74ce87b1914&type=3#Button-Click");
    background-color: rgba(0, 0, 0, 0);
}

.exit-confirm-button:disabled {
    opacity: 0.45;
}

.pause-panel-title {
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 72px;
    color: var(--text-on-panel);
    -unity-text-align: middle-center;
    margin-bottom: 42px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--text-on-panel);
}

.pause-panel-button-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.pause-panel-icon-button {
    width: 120px;
    height: 120px;
    margin-left: 18px;
    margin-right: 18px;
    background-color: rgba(255, 255, 255, 0);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
}

.pause-panel-icon-button:active {
    background-color: rgba(255, 255, 255, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.pause-resume-button {
    background-image: url("project://database/Assets/View/UI/Sprites/Icons/Icon-Play-Idle.png?fileID=21300000&guid=e75ae3b749cc616fb77435174f34c6cd&type=3#Icon-Play-Idle");
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
}

.pause-resume-button:active {
    background-image: url("project://database/Assets/View/UI/Sprites/Icons/Icon-Play-Click.png?fileID=21300000&guid=7dd80df28075fec37893a0154192a3cf&type=3#Icon-Play-Click");
}

.pause-home-button {
    background-image: url("project://database/Assets/View/UI/Sprites/Icons/Icon-Home-Idle.png?fileID=21300000&guid=fe2a2793a4456b396a2bbcd21a2c435f&type=3#Icon-Home-Idle");
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
}

.pause-text-button {
    width: 180px;
    background-color: var(--surface-panel-soft);
    border-left-color: var(--play-wood);
    border-right-color: var(--play-wood);
    border-top-color: var(--play-wood);
    border-bottom-color: var(--play-wood);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    color: var(--text-on-panel);
    font-size: 28px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.pause-text-button:disabled {
    opacity: 0.45;
}

.pause-text-button:active {
    background-color: var(--surface-panel-soft);
}

.pause-home-button:active {
    background-image: url("project://database/Assets/View/UI/Sprites/Icons/Icon-Home-Click.png?fileID=21300000&guid=58259a5a87b94e52b25437a19febd4bf&type=3#Icon-Home-Click");
}

