/* Kotak dropdown risiko. Radius dan garis tepi dipasang pada .unity-base-field__input, elemen dalam
   yang menggambar kotaknya -- radius pada pembungkusnya saja tidak akan terlihat. */
.risk-card-dropdown .unity-base-field__input {
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: var(--play-line);
    border-right-color: var(--play-line);
    border-bottom-color: var(--play-line);
    border-left-color: var(--play-line);
    padding-left: 16px;
    background-color: var(--surface-panel);
}

/* Daftar pilihan yang muncul saat dropdown dibuka. Elemen-elemen ini dibuat UI Toolkit di akar
   panel, bukan di dalam dropdown-nya, sehingga tidak dapat dijangkau lewat pemilih keturunan dari
   .risk-card-dropdown dan harus ditulis sebagai aturan tersendiri. */
.unity-base-dropdown__container-outer {
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
}

.unity-base-dropdown__item {
    min-height: 54px;
    padding-left: 16px;
}

.unity-base-dropdown__label {
    font-size: 36px;
    color: var(--text-on-panel);
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
}
