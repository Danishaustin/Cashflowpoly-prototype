:root {
    --text-on-panel: rgb(27, 63, 91);
    --text-on-fill: rgb(255, 255, 255);
    --play-line: rgb(154, 215, 207);
    --play-panel-deep: rgb(79, 110, 131);
    --play-panel-light: rgb(95, 122, 139);
    --play-wood: rgb(182, 220, 216);
    --play-green: rgb(15, 118, 110);
    --surface-panel: rgba(255, 255, 255, 0.95);
    --surface-panel-soft: rgba(15, 23, 42, 0.06);
    --scrim-tipis: rgba(0, 0, 0, 0.18);
    --scrim-sedang: rgba(0, 0, 0, 0.3);
    --scrim: rgba(0, 0, 0, 0.45);
    --status-baik: rgb(22, 101, 52);
    --status-bahaya: rgb(157, 44, 44);
    --status-perhatian: rgb(154, 107, 0);
    --status-netral: rgb(61, 98, 119);
    --tekan-tint: rgb(175, 175, 175);
    --pilih-tint: rgba(255, 255, 255, 0.35);
}

.choice-background {
    -unity-background-scale-mode: scale-and-crop;
}

Button {
    background-color: rgba(255, 255, 255, 0);
    transform-origin: center;
    transition-property: scale;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
}

Button:active {
    scale: 0.9 0.9;
    transition-duration: 0.08s;
    transition-timing-function: ease-in-out;
}

.background-transition-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    display: none;
    transition-property: opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-in-out;
}

.show-background-transition {
    opacity: 1;
}

.background-city {
    background-image: url("project://database/Assets/View/UI/Sprites/Background/City.png?fileID=21300000&guid=f150ff836c6632443a474cc64e662bdd&type=3#City");
}

.background-choice-bm {
    background-image: url("project://database/Assets/View/UI/Sprites/Background/choice_bm.png?fileID=21300000&guid=9d23042cd07c3fe42acd29ca1600f712&type=3#choice_bm");
}

.background-choice-k {
    background-image: url("project://database/Assets/View/UI/Sprites/Background/choice_k.png?fileID=21300000&guid=cb4cfc7c91acedd41968dc243f735b15&type=3#choice_k");
}

.background-choice-jm {
    background-image: url("project://database/Assets/View/UI/Sprites/Background/choice_jm.png?fileID=21300000&guid=a92124515d9217043b2a824b967cffc0&type=3#choice_jm");
}

.background-choice-tf {
    background-image: url("project://database/Assets/View/UI/Sprites/Background/choice_tf.png?fileID=21300000&guid=cbc7162caba0adf40a9ecc134f92792f&type=3#choice_tf");
}

.character {
    background-image: url("project://database/Assets/Screenshot_12-3-2026_135519_static.vecteezy.com-removebg-preview.png?fileID=21300000&guid=fd59a42e74877d04392891d8547925e2&type=3#Screenshot_12-3-2026_135519_static.vecteezy.com-removebg-preview");
    -unity-background-scale-mode: stretch-to-fill;
    scale: 1 1;
    top: auto;
    width: 600px;
    height: 80%;
    bottom: 0;
    translate: 100% 0;
    position: absolute;
    right: 0;
    transition-property: translate;
    transition-timing-function: ease-in-sine;
    transition-duration: 0.25s;
}

.show-character {
    translate: 0 0;
}

.dialog-character-left {
    left: 0;
    right: auto;
    translate: -100% 0;
    scale: 1 1;
}

.show-dialog-character-left {
    translate: 0 0;
}

.npc-character {
    left: 0;
    right: auto;
    translate: -100% 0;
    scale: 1 1;
}

.show-npc-character {
    translate: 0 0;
}

.choice-button {
    background-color: rgba(255, 255, 255, 0);
    margin-top: 1%;
    margin-bottom: 2%;
    -unity-font: url("project://database/Assets/Resources/Sprite/300Mind/2D%20Game%20UI%20Kit/Fonts/Ariston%20Comic%20Font.ttf?fileID=12800000&guid=e28e9ad7f0a79f14d8c01971d5416eba&type=3#Ariston Comic Font");
    -unity-font-definition: initial;
    font-size: 56px;
    -unity-font-style: normal;
    background-image: url("project://database/Assets/View/UI/Sprites/Icons/Button-Wide-Idle.png?fileID=21300000&guid=5e9b9843e77b635451e5a48a264d9f6b&type=3#Button-Wide-Idle");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 1px;
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
}

.choice-list {
    flex-grow: 1;
    position: absolute;
    width: 50%;
    height: 100%;
    justify-content: center;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    translate: 0 -100%;
    transition-timing-function: ease-out-back;
    transition-duration: 0.45s;
}

.main-choice-list {
    width: 74%;
    height: 78%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    align-content: center;
    padding-top: 2%;
    padding-right: 2%;
    padding-bottom: 2%;
    padding-left: 2%;
    scale: 1 1;
    translate: 0 -120%;
}

.main-choice-button {
    width: 41%;
    height: 18%;
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 1.2%;
    margin-right: 3%;
    margin-bottom: 1.2%;
    margin-left: 3%;
    font-size: 36px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.main-choice-icon {
    position: absolute;
    left: 22px;
    top: 50%;
    translate: 0 -50%;
    width: 92px;
    height: 92px;
    border-top-left-radius: 46px;
    border-top-right-radius: 46px;
    border-bottom-right-radius: 46px;
    border-bottom-left-radius: 46px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: var(--surface-panel);
    border-right-color: var(--surface-panel);
    border-bottom-color: var(--surface-panel);
    border-left-color: var(--surface-panel);
    background-color: var(--surface-panel);
    -unity-background-scale-mode: scale-and-crop;
}

.target-kebutuhan-panel {
    padding-top: 2%;
    padding-right: 4%;
    padding-bottom: 4%;
    padding-left: 4%;
    translate: 0 -140%;
}

.initial-bahan-panel {
    padding-top: 2%;
    padding-right: 4%;
    padding-bottom: 4%;
    padding-left: 4%;
    translate: 0 -140%;
}

.initial-bahan-panel.show-choice {
    translate: 0 0;
}

.initial-bahan-title {
    width: 82%;
    min-height: 86px;
    align-self: center;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 44px;
    color: var(--text-on-panel);
    -unity-text-align: middle-center;
    white-space: normal;
    background-color: var(--surface-panel);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    padding-top: 12px;
    padding-right: 20px;
    padding-bottom: 12px;
    padding-left: 20px;
    margin-bottom: 3.5%;
    -unity-text-outline-width: 0.6px;
    -unity-text-outline-color: var(--text-on-panel);
}

.initial-bahan-grid {
    width: 100%;
    flex-grow: 1;
    height: 74%;
    margin-top: 1.5%;
    margin-bottom: 3.5%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-content: center;
}

.initial-bahan-button {
    width: 25%;
    height: 50%;
    margin-top: 1.2%;
    margin-right: 1.4%;
    margin-bottom: 1.2%;
    margin-left: 1.4%;
    position: relative;
    -unity-background-scale-mode: stretch-to-fill;
}

/* Yang diredupkan hanya gambar bahannya lewat tint, bukan opacity tombolnya: opacity ikut
   meredupkan centang di dalamnya, padahal centang itu justru penanda terpilih. */
.selected-initial-bahan {
    scale: 1.08 1.08;
    -unity-background-image-tint-color: var(--pilih-tint);
}

.initial-bahan-check {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 40px;
    height: 40px;
    display: none;
    background-color: var(--play-green);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 28px;
    color: var(--text-on-fill);
    -unity-text-align: middle-center;
}

.selected-initial-bahan .initial-bahan-check {
    display: flex;
}

.initial-bahan-footer {
    width: 100%;
    height: 18%;
    justify-content: center;
    align-items: center;
}

.initial-bahan-next-button {
    width: 180px;
    height: 78px;
    background-image: url("project://database/Assets/View/UI/Sprites/Icons/Button-Idle.png?fileID=21300000&guid=eb7df812497e1784eed21e2d0c3d59aa&type=3#Button-Idle");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 32px;
    color: var(--text-on-panel);
    -unity-text-align: middle-center;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
}

.initial-bahan-next-button:active {
    background-image: url("project://database/Assets/View/UI/Sprites/Icons/Button-Click.png?fileID=21300000&guid=02413f5eb0cc0c4b5d9cf74ce87b1914&type=3#Button-Click");
}

.target-kebutuhan-panel.show-choice {
    translate: 0 0;
}

.target-kebutuhan-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background-color: var(--scrim);
}

.target-kebutuhan-title {
    width: 82%;
    min-height: 86px;
    align-self: center;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 44px;
    color: var(--text-on-panel);
    -unity-text-align: middle-center;
    white-space: normal;
    background-color: var(--surface-panel);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    padding-top: 12px;
    padding-right: 20px;
    padding-bottom: 12px;
    padding-left: 20px;
    margin-bottom: 2%;
    -unity-text-outline-width: 0.6px;
    -unity-text-outline-color: var(--text-on-panel);
}

.target-kebutuhan-grid {
    width: 100%;
    flex-grow: 1;
    height: 72%;
    margin-bottom: 2%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-content: center;
}

.target-kebutuhan-button {
    width: 44%;
    height: 44%;
    margin-top: 2%;
    margin-right: 2%;
    margin-bottom: 2%;
    margin-left: 2%;
    padding-top: 14px;
    padding-right: 14px;
    padding-bottom: 14px;
    padding-left: 14px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-image: url("project://database/Assets/View/UI/Sprites/Icons/Button-Item-Idle.png?fileID=21300000&guid=df14682f6f470c44f00a1af38da17b48&type=3#Button-Item-Idle");
    -unity-background-scale-mode: stretch-to-fill;
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    position: relative;
}

.target-kebutuhan-button:active {
    -unity-background-image-tint-color: var(--tekan-tint);
}

/* Sama seperti bahan awal: tint meredupkan gambarnya saja, angka urutan tetap pekat. */
.selected-target-kebutuhan {
    scale: 1.06 1.06;
    -unity-background-image-tint-color: var(--pilih-tint);
}

.target-kebutuhan-order-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 64px;
    height: 64px;
    display: none;
    justify-content: center;
    align-items: center;
    background-color: var(--play-green);
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    border-bottom-left-radius: 32px;
    border-bottom-right-radius: 32px;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 44px;
    color: var(--text-on-fill);
    -unity-text-align: middle-center;
}

.target-kebutuhan-footer {
    width: 100%;
    height: 15%;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.target-kebutuhan-action-button {
    width: 170px;
    height: 72px;
    margin-left: 10px;
    margin-right: 10px;
    background-image: url("project://database/Assets/View/UI/Sprites/Icons/Button-Idle.png?fileID=21300000&guid=eb7df812497e1784eed21e2d0c3d59aa&type=3#Button-Idle");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 32px;
    color: var(--text-on-panel);
    -unity-text-align: middle-center;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
}

.target-kebutuhan-action-button:active {
    background-image: url("project://database/Assets/View/UI/Sprites/Icons/Button-Click.png?fileID=21300000&guid=02413f5eb0cc0c4b5d9cf74ce87b1914&type=3#Button-Click");
}

.menabung-title-text {
    width: 82%;
    min-height: 86px;
    align-self: center;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 44px;
    color: var(--text-on-panel);
    -unity-text-align: middle-center;
    white-space: normal;
    background-color: var(--surface-panel);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    padding-top: 12px;
    padding-right: 20px;
    padding-bottom: 12px;
    padding-left: 20px;
    margin-bottom: 2%;
    -unity-text-outline-width: 0.6px;
    -unity-text-outline-color: var(--text-on-panel);
}

.selesai-panel {
    width: 100%;
    height: 72%;
    align-self: center;
    align-items: center;
    justify-content: flex-start;
    padding-top: 36px;
    padding-right: 48px;
    padding-bottom: 36px;
    padding-left: 48px;
    background-color: var(--surface-panel);
    border-top-left-radius: 36px;
    border-top-right-radius: 36px;
    border-bottom-right-radius: 36px;
    border-bottom-left-radius: 36px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: var(--play-line);
    border-right-color: var(--play-line);
    border-top-color: var(--play-line);
    border-bottom-color: var(--play-line);
}

.selesai-title {
    width: 100%;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 56px;
    color: var(--text-on-panel);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 8px;
    -unity-text-outline-width: 0.8px;
    -unity-text-outline-color: var(--text-on-panel);
}

.selesai-subtitle {
    width: 100%;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    font-size: 32px;
    color: var(--play-panel-deep);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 18px;
}

.selesai-view-button {
    width: 260px;
    height: 86px;
    margin-left: 14px;
    margin-right: 14px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/View/UI/Sprites/Icons/Button-Idle.png?fileID=21300000&guid=eb7df812497e1784eed21e2d0c3d59aa&type=3#Button-Idle");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 36px;
    color: var(--text-on-panel);
    -unity-text-align: middle-center;
    white-space: nowrap;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
}

.selesai-view-button:active {
    background-image: url("project://database/Assets/View/UI/Sprites/Icons/Button-Click.png?fileID=21300000&guid=02413f5eb0cc0c4b5d9cf74ce87b1914&type=3#Button-Click");
    background-color: rgba(0, 0, 0, 0);
}

.selesai-score-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
    margin-top: 12px;
    padding-top: 16px;
    padding-right: 22px;
    padding-bottom: 16px;
    padding-left: 22px;
    background-color: var(--surface-panel-soft);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
}

.selesai-score-row {
    width: 100%;
    font-size: 32px;
    color: var(--text-on-panel);
    -unity-text-align: middle-left;
    white-space: normal;
    margin-bottom: 4px;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
}

.selesai-score-title {
    width: 100%;
    font-size: 32px;
    -unity-font-style: normal;
    color: var(--text-on-panel);
    -unity-text-align: middle-left;
    margin-top: 10px;
    margin-bottom: 2px;
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: var(--text-on-panel);
}

.action-confirm-panel {
    width: 58%;
    height: 40%;
    background-color: var(--surface-panel);
    border-top-left-radius: 36px;
    border-top-right-radius: 36px;
    border-bottom-right-radius: 36px;
    border-bottom-left-radius: 36px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: var(--play-line);
    border-right-color: var(--play-line);
    border-top-color: var(--play-line);
    border-bottom-color: var(--play-line);
    padding-top: 4%;
    padding-right: 5%;
    padding-bottom: 4%;
    padding-left: 5%;
    translate: 0 -200%;
}

.tf-confirm-panel {
    width: 58%;
    height: 44%;
    background-color: var(--surface-panel);
    border-top-left-radius: 36px;
    border-top-right-radius: 36px;
    border-bottom-right-radius: 36px;
    border-bottom-left-radius: 36px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: var(--play-line);
    border-right-color: var(--play-line);
    border-top-color: var(--play-line);
    border-bottom-color: var(--play-line);
    padding-top: 4%;
    padding-right: 5%;
    padding-bottom: 4%;
    padding-left: 5%;
    translate: 0 -200%;
}

.tf-confirm-text {
    width: 100%;
    flex-grow: 1;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 44px;
    color: var(--text-on-panel);
    -unity-text-align: middle-center;
    white-space: normal;
}

.tf-confirm-buttons {
    width: 100%;
    height: 34%;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.show-choice {
    translate: 0 0;
}

.choice-button:active {
    -unity-background-image-tint-color: var(--tekan-tint);
}

.choice-button:disabled {
    opacity: 0.45;
    -unity-background-image-tint-color: rgb(150, 150, 150);
}

.risk-panel {
    background-color: var(--surface-panel);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: var(--play-line);
    border-right-color: var(--play-line);
    border-top-color: var(--play-line);
    border-bottom-color: var(--play-line);
    border-top-left-radius: 36px;
    border-top-right-radius: 36px;
    border-bottom-left-radius: 36px;
    border-bottom-right-radius: 36px;
    padding-top: 3%;
    padding-right: 5%;
    padding-bottom: 3%;
    padding-left: 5%;
    translate: 0 -130%;
}

.risk-panel.show-choice {
    translate: 0 0;
}

.risk-panel-header {
    height: 14%;
    width: 100%;
    justify-content: center;
    align-items: center;
    background-color: var(--surface-panel-soft);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: var(--play-line);
    border-right-color: var(--play-line);
    border-top-color: var(--play-line);
    border-bottom-color: var(--play-line);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    margin-bottom: 10px;
}

.risk-panel-title {
    width: 100%;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 44px;
    color: var(--text-on-panel);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0.6px;
    -unity-text-outline-color: var(--text-on-panel);
}

.risk-content {
    flex-grow: 1;
    width: 100%;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
    padding-top: 8px;
    padding-bottom: 8px;
    overflow: hidden;
}

.risk-setup-content {
    overflow: auto;
}

.risk-decision-player-text {
    width: 100%;
    min-height: 56px;
    margin-bottom: 10px;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 36px;
    color: var(--text-on-panel);
    -unity-text-align: middle-center;
    white-space: normal;
}

.risk-toggle {
    min-height: 52px;
    height: auto;
    width: 100%;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 36px;
    color: var(--text-on-panel);
    -unity-text-align: middle-left;
    margin-top: 2px;
    margin-bottom: 2px;
}

.risk-toggle:disabled {
    opacity: 0.45;
}

.risk-sub-toggle {
    width: 100%;
    min-height: 46px;
    font-size: 28px;
    margin-left: 24px;
}

.risk-card-dropdown {
    width: 96%;
    min-height: 62px;
    align-self: center;
    margin-top: 6px;
    margin-bottom: 6px;
    font-size: 36px;
    color: var(--text-on-panel);
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    background-color: rgba(255, 255, 255, 0);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
}

.risk-warning-text {
    width: 100%;
    min-height: 36px;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 32px;
    color: var(--status-bahaya);
    -unity-text-align: middle-center;
    white-space: normal;
}

.risk-number-input-row {
    flex-grow: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    min-height: 52px;
    margin-top: 2px;
    margin-bottom: 6px;
}

.risk-number-button {
    min-height: 42px;
    font-size: 36px;
    margin-top: 0;
    margin-bottom: 0;
}

.risk-number-text {
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 44px;
    -unity-text-align: middle-center;
    background-image: none;
    background-color: var(--surface-panel);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    min-height: 42px;
}

.item-choice-list {
    position: absolute;
    width: 50%;
    height: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    align-content: center;
    padding-top: 4%;
    padding-right: 4%;
    padding-bottom: 4%;
    padding-left: 4%;
    translate: 0 -100%;
    transition-timing-function: ease-out-back;
    transition-duration: 0.45s;
}

.item-choice-list.show-choice {
    translate: 0 0;
}

.jual-masakan-choice-list {
    width: 72%;
    padding-left: 2%;
    padding-right: 2%;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: center;
}

/* Panel jual masakan lebih lebar daripada panel item lain (72% lawan 50%), sedangkan panah
   diletakkan dengan persentase terhadap panel itu sendiri. Persentase yang sama karena itu
   menghasilkan jarak nyata yang jauh lebih besar di sini. Angka di bawah menyamakan jaraknya
   dengan panel item lain: 35% x 72% = 25,2% lebar layar, sama seperti 28% x 50% = 14% diukur
   dari tengah panel masing-masing. */
.jual-masakan-choice-list .item-page-previous-button {
    left: 35%;
}

.jual-masakan-choice-list .item-page-next-button {
    right: 35%;
}

.item-back-button {
    position: absolute;
    bottom: 10%;
    left: 50%;
    width: 140px;
    height: 72px;
    translate: -50% 0;
    background-color: rgba(255, 255, 255, 0);
    background-image: url("project://database/Assets/View/UI/Sprites/Icons/Button-Idle.png?fileID=21300000&guid=eb7df812497e1784eed21e2d0c3d59aa&type=3#Button-Idle");
