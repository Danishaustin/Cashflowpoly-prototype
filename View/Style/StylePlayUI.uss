    font-size: 32px;
    color: var(--text-on-panel);
    -unity-text-align: middle-center;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
}

.item-back-button:active {
    background-image: url("project://database/Assets/View/UI/Sprites/Icons/Button-Click.png?fileID=21300000&guid=02413f5eb0cc0c4b5d9cf74ce87b1914&type=3#Button-Click");
}

