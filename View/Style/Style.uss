.password-toggle {
    position: absolute;
    right: 0;
    top: 9px;
    bottom: 0;
    width: 56px;
    background-color: rgba(255, 255, 255, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-image: resource('Sprite/Tema/ikon-mata-buka');
    -unity-background-scale-mode: scale-to-fit;
    height: 56px;
}

.password-toggle:hover {
    opacity: 0.65;
}

.password-toggle.password-terlihat {
    background-image: resource('Sprite/Tema/ikon-mata-tutup');
}

