    position: absolute;
    width: 100%;
    height: 100%;
    translate: 100% 0;
    opacity: 1;
    transition-duration: 0.45s;
    transition-timing-function: ease-out-cubic;
}

.show-edit-narasi-select {
    translate: 0 0;
}

.hide-edit-narasi-select-left {
    translate: -100% 0;
}

.edit-narasi-select-body {
