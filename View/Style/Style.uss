:root {
    --bg-page: rgb(202, 238, 225);
    --surface-card: rgba(255, 255, 255, 0.86);
    --surface-raised: rgb(182, 220, 216);
    --surface-input: rgb(182, 220, 216);
    --surface-list: rgb(245, 245, 245);
    --chip-fill: rgba(15, 23, 42, 0.06);
    --badge-fill: rgba(15, 23, 42, 0.08);
    --line: rgb(182, 220, 216);
    --line-strong: rgb(154, 215, 207);
    --text-body: rgb(15, 23, 42);
    --text-on-fill: rgb(255, 255, 255);
    --text-muted: rgb(79, 110, 131);
    --text-on-light: rgb(15, 23, 42);
    --text-title: rgb(27, 63, 91);
    --text-on-button: rgb(255, 255, 255);
    --text-faint: rgb(104, 126, 142);
    --accent: rgb(15, 118, 110);
    --accent-soft: rgba(15, 118, 110, 0.45);
    --accent-bright: rgb(15, 118, 110);
    --accent-bright-soft: rgba(15, 118, 110, 0.15);
    --accent-warm: rgb(245, 158, 11);
    --danger: rgb(157, 44, 44);
    --danger-strong: rgb(127, 29, 29);
    --danger-text: rgb(157, 44, 44);
}

.home-title {
    margin-top: 20px;
    margin-right: 20px;
    margin-bottom: 20px;
    margin-left: 20px;
    width: 600px;
    -unity-font: url("project://database/Assets/Resources/Sprite/300Mind/2D%20Game%20UI%20Kit/Fonts/Ariston%20Comic%20Font.ttf?fileID=12800000&guid=e28e9ad7f0a79f14d8c01971d5416eba&type=3#Ariston Comic Font");
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 100px;
    justify-content: flex-start;
    align-items: stretch;
    -unity-text-align: upper-center;
    background-image: url("project://database/Assets/Resources/Sprite/Tema/UI-pack_Sprite_1_tema.png?fileID=534250303759604497&guid=f7b034d8ea0460cbd01ae429e619e4bd&type=3#UI-pack_Sprite_1_21");
    height: 130px;
    color: var(--text-title);
    text-overflow: clip;
    max-width: 600px;
    min-width: 100px;
    -unity-text-outline-width: 1.4px;
    -unity-text-outline-color: var(--text-title);
}

.home-button {
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
    font-size: 56px;
    -unity-font: url("project://database/Assets/Resources/Sprite/300Mind/2D%20Game%20UI%20Kit/Fonts/Ariston%20Comic%20Font.ttf?fileID=12800000&guid=e28e9ad7f0a79f14d8c01971d5416eba&type=3#Ariston Comic Font");
    -unity-font-style: normal;
    text-overflow: ellipsis;
    -unity-font-definition: initial;
    margin-top: 20px;
    margin-right: 0;
    margin-bottom: 20px;
    margin-left: 0;
    width: 300px;
    height: 100px;
    align-items: stretch;
    background-image: url("project://database/Assets/Resources/Sprite/Tema/UI-pack_Sprite_2_tema.png?fileID=-8760834427580073799&guid=85d22325c25a042ccf701995a3514346&type=3#UI-pack_Sprite_2_16");
    cursor: initial;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    transition-timing-function: ease-out;
    transition-duration: 0.1s;
    color: var(--text-on-button);
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(255, 255, 255, 0);
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
}

.home-button:active {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.78);
    scale: 0.9 0.9;
}

.navbar-button {
    height: 100px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    align-self: auto;
}

.quest-button {
    height: 100px;
    margin-top: 2px;
    margin-right: 4px;
    margin-bottom: 2px;
    margin-left: 4px;
    width: 300px;
}

.main-container {
    flex-grow: 1;
    background-color: rgb(139, 92, 255);
    background-image: url("project://database/Assets/Resources/Sprite/300Mind/2D%20Game%20UI%20Kit/Sprites/UI-pack_Sprite_2.png?fileID=-5900999151167789326&guid=39e0242329775814891ef673e48ae932&type=3#UI-pack_Sprite_2_2");
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.navbar {
    flex-grow: 1;
    width: 100%;
    height: 25%;
    justify-content: space-between;
    flex-direction: row;
    padding-right: 5%;
    padding-left: 5%;
    align-items: center;
}

.quest-page {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.59);
    translate: -100% 0;
    transition-duration: 0.5s;
    transition-timing-function: ease-out-cubic;
    display: flex;
}

.show-add-player {
    translate: 0 0;
}

.add-player-body {
    flex-grow: 1;
    height: 100%;
    width: 100%;
    justify-content: center;
    align-items: center;
    padding-bottom: 8%;
}

.add-player-form {
    width: 578px;
    height: 670px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.add-player-title {
    width: 520px;
    height: 130px;
    color: var(--accent);
    font-size: 100px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/Resources/Sprite/300Mind/2D%20Game%20UI%20Kit/Fonts/Ariston%20Comic%20Font.ttf?fileID=12800000&guid=e28e9ad7f0a79f14d8c01971d5416eba&type=3#Ariston Comic Font");
    -unity-font-definition: initial;
    -unity-font-style: normal;
    -unity-text-outline-width: 1.4px;
    -unity-text-outline-color: var(--accent);
}

.add-player-input-container {
    width: 100%;
    height: 280px;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    background-color: rgba(255, 255, 255, 0);
    margin-bottom: 20px;
}

.login-page {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--bg-page);
    background-image: resource('Sprite/Tema/latar-tema-terang');
    -unity-background-scale-mode: scale-and-crop;
    translate: 0 100%;
    transition-duration: 0.5s;
    transition-timing-function: ease-out-cubic;
    align-items: center;
    justify-content: center;
    display: flex;
}

.login-form {
    width: 578px;
    height: 840px;
    flex-direction: column;
    align-items: center;
    justify-content: space-around;
}

.auth-loading-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.35);
    justify-content: center;
    align-items: center;
}

.auth-loading-card {
    width: 260px;
    height: 180px;
    padding-top: 24px;
    padding-right: 24px;
    padding-bottom: 24px;
    padding-left: 24px;
    justify-content: center;
    align-items: center;
    background-color: var(--bg-page);
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-right-radius: 28px;
    border-bottom-left-radius: 28px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: var(--surface-raised);
    border-right-color: var(--surface-raised);
    border-bottom-color: var(--surface-raised);
    border-left-color: var(--surface-raised);
}

.auth-loading-spinner {
    width: 60px;
    height: 60px;
    margin-bottom: 14px;
    border-top-width: 6px;
    border-right-width: 6px;
    border-bottom-width: 6px;
    border-left-width: 6px;
    border-top-color: var(--accent-bright);
    border-right-color: var(--accent-bright-soft);
    border-bottom-color: var(--accent-bright-soft);
    border-left-color: var(--accent-bright-soft);
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-right-radius: 999px;
    border-bottom-left-radius: 999px;
}

.auth-loading-text {
    color: var(--text-body);
    font-size: 32px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/Resources/Sprite/300Mind/2D%20Game%20UI%20Kit/Fonts/Ariston%20Comic%20Font.ttf?fileID=12800000&guid=e28e9ad7f0a79f14d8c01971d5416eba&type=3#Ariston Comic Font");
    -unity-font-definition: initial;
    -unity-font-style: normal;
}

.play-loading-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.42);
    justify-content: center;
    align-items: center;
}

.play-loading-card {
    width: 360px;
    height: 220px;
    padding-top: 28px;
    padding-right: 28px;
    padding-bottom: 28px;
    padding-left: 28px;
    justify-content: center;
    align-items: center;
    background-color: var(--bg-page);
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    border-bottom-right-radius: 32px;
    border-bottom-left-radius: 32px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: var(--surface-input);
    border-right-color: var(--surface-input);
    border-bottom-color: var(--surface-input);
    border-left-color: var(--surface-input);
}

.play-loading-spinner {
    width: 74px;
    height: 74px;
    margin-bottom: 18px;
    border-top-width: 8px;
    border-right-width: 8px;
    border-bottom-width: 8px;
    border-left-width: 8px;
    border-top-color: var(--accent-bright);
    border-right-color: var(--accent-bright-soft);
    border-bottom-color: var(--accent-bright-soft);
    border-left-color: var(--accent-bright-soft);
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-right-radius: 999px;
    border-bottom-left-radius: 999px;
}

.play-loading-text {
    color: var(--text-body);
    font-size: 32px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/Resources/Sprite/300Mind/2D%20Game%20UI%20Kit/Fonts/Ariston%20Comic%20Font.ttf?fileID=12800000&guid=e28e9ad7f0a79f14d8c01971d5416eba&type=3#Ariston Comic Font");
    -unity-font-definition: initial;
    -unity-font-style: normal;
}

.input-field {
    width: 100%;
    flex-direction: column;
    height: 70px;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    font-size: 44px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
}

.label-field {
    -unity-font: url("project://database/Assets/Resources/Sprite/300Mind/2D%20Game%20UI%20Kit/Fonts/Ariston%20Comic%20Font.ttf?fileID=12800000&guid=e28e9ad7f0a79f14d8c01971d5416eba&type=3#Ariston Comic Font");
    -unity-font-definition: initial;
    -unity-font-style: normal;
    color: var(--accent);
    font-size: 44px;
    padding-left: 10px;
    width: 100%;
    -unity-text-outline-width: 0.6px;
    -unity-text-outline-color: var(--accent);
}

.show-login {
    translate: 0 0;
}

.session-setup-page {
    background-color: var(--bg-page);
    background-image: resource('Sprite/Tema/latar-tema-terang');
    -unity-background-scale-mode: scale-and-crop;
    display: flex;
    position: absolute;
    width: 100%;
    height: 100%;
    translate: 0 -100%;
    transition-duration: 0.55s;
    transition-timing-function: ease-out-cubic;
}

.show-session-setup {
    translate: 0 0;
}

.hide-session-setup-left {
    translate: -100% 0;
}

.session-setup-navbar {
    flex-grow: 0;
}

.session-setup-body {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: flex-start;
    align-items: center;
    padding-bottom: 8%;
}

.session-setup-form {
    width: 1238px;
    height: 680px;
    justify-content: space-around;
    align-items: center;
    margin-top: -40px;
}

.session-setup-title {
    width: 100%;
    height: 130px;
    color: var(--accent);
    font-size: 100px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/Resources/Sprite/300Mind/2D%20Game%20UI%20Kit/Fonts/Ariston%20Comic%20Font.ttf?fileID=12800000&guid=e28e9ad7f0a79f14d8c01971d5416eba&type=3#Ariston Comic Font");
    -unity-font-definition: initial;
    -unity-font-style: normal;
    -unity-text-outline-width: 1.4px;
    -unity-text-outline-color: var(--accent);
}

.session-setup-input-container {
    width: 100%;
    height: auto;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    background-color: rgba(255, 255, 255, 0);
}

.session-setup-column {
    width: 48%;
    margin-left: 1%;
    margin-right: 1%;
    flex-direction: column;
    align-items: stretch;
}

.session-setup-column .session-pack-dropdown {
    margin-bottom: 22px;
}

.ruleset-selector-row .session-setup-input {
    margin-bottom: 0;
}

.session-setup-input {
    height: 70px;
    margin-bottom: 22px;
}

/* Pembungkus kolom isian yang punya teks bayangan. Posisinya relatif secara bawaan, jadi cukup
   dipakai sebagai acuan bagi bayangannya yang absolut. */
.input-placeholder-row {
    width: 100%;
    flex-direction: column;
}

/* Bayangan ini hanya gambar: picking-mode Ignore di UXML membuatnya tidak pernah menangkap klik,
   sehingga menekan teksnya tetap menaruh kursor di kolom isiannya. Sisi kirinya disetel 27px agar
   sebaris dengan teks asli, yang digeser 25px oleh padding .unity-base-text-field__input ditambah
   padding bawaan elemen teksnya. */
.input-placeholder {
    position: absolute;
    left: 27px;
    top: 0;
    height: 70px;
    font-size: 44px;
    color: var(--text-faint);
    -unity-text-align: middle-left;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
}

.ruleset-selector-row {
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 22px;
    height: 100px;
}

.ruleset-mode-dropdown {
    color: var(--text-on-light);
    background-color: rgba(255, 255, 255, 0);
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
}

.ruleset-dropdown {
    color: var(--text-on-light);
    background-color: rgba(255, 255, 255, 0);
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
}

.ruleset-mode-dropdown {
    width: 34%;
    min-width: 180px;
    margin-right: 4px;
    margin-bottom: 16px;
    background-color: rgba(255, 255, 255, 0);
}

.ruleset-dropdown {
    flex-grow: 1;
    margin-bottom: 0;
    background-color: rgba(255, 255, 255, 0);
}

.ruleset-dropdown-locked {
    background-color: var(--chip-fill);
    color: var(--text-on-light);
    opacity: 0.72;
}

.ruleset-suggestion-button {
    width: 100%;
    height: 66px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 8px;
    margin-left: 0;
    font-size: 32px;
}

.player-suggestions-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.player-suggestions-panel {
    position: absolute;
    width: 280px;
    max-height: 316px;
    flex-direction: column;
    background-color: rgba(243, 243, 243, 0.98);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.18);
    border-right-color: rgba(0, 0, 0, 0.18);
    border-bottom-color: rgba(0, 0, 0, 0.18);
    border-left-color: rgba(0, 0, 0, 0.18);
}

.player-suggestion-button {
    width: 100%;
    height: 66px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 4px;
    margin-left: 0;
    font-size: 32px;
    color: rgb(36, 36, 36);
    background-color: rgba(255, 255, 255, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 1px;
    border-left-width: 0;
    border-bottom-color: rgba(0, 0, 0, 0.08);
    -unity-text-align: middle-left;
    -unity-font-style: normal;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
}

.player-suggestion-button:hover {
    background-color: rgb(0, 125, 255);
    color: var(--text-on-fill);
}

.player-suggestion-button:active {
    background-color: rgba(0, 0, 0, 0.12);
}

.session-setup-next-button {
    position: absolute;
    right: 5%;
    bottom: 5%;
}

.play-page {
    background-color: var(--bg-page);
    background-image: resource('Sprite/Tema/latar-tema-terang');
    -unity-background-scale-mode: scale-and-crop;
    display: flex;
    position: absolute;
    width: 100%;
    height: 100%;
    translate: 100% 0;
    transition-duration: 0.5s;
    transition-timing-function: ease-out-cubic;
    opacity: 0;
}

.show-play {
    translate: 0 0;
    opacity: 1;
}

.error-popup-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.48);
    opacity: 0;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.show-error-popup-overlay {
    opacity: 1;
}

.error-popup-card {
    width: 560px;
    min-height: 300px;
    padding-top: 34px;
    padding-right: 38px;
    padding-bottom: 32px;
    padding-left: 38px;
    justify-content: center;
    align-items: center;
    background-color: var(--bg-page);
    border-top-left-radius: 34px;
    border-top-right-radius: 34px;
    border-bottom-right-radius: 34px;
    border-bottom-left-radius: 34px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: var(--line-strong);
    border-right-color: var(--line-strong);
    border-bottom-color: var(--line-strong);
    border-left-color: var(--line-strong);
    scale: 0 0;
    opacity: 0;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.show-error-popup {
    scale: 1 1;
    opacity: 1;
}

.error-popup-title {
    width: 100%;
    min-height: 72px;
    color: var(--danger-text);
    opacity: 1;
    font-size: 44px;
    -unity-text-align: middle-center;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
    -unity-text-outline-width: 0.6px;
    -unity-text-outline-color: var(--danger-text);
}

.error-popup-title-success {
    color: rgb(22, 101, 52);
    -unity-text-outline-color: rgb(22, 101, 52);
}

.error-popup-message {
    width: 100%;
    min-height: 110px;
    color: var(--text-body);
    opacity: 1;
    font-size: 36px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 12px;
    margin-bottom: 18px;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
}

.error-popup-button {
    width: 220px;
    height: 82px;
    font-size: 44px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

/* Sprite tombol Home diganti isian rata merah, bukan diberi tint: sprite itu punya warna sendiri,
   dan menimpanya dengan merah tua menghasilkan warna keruh yang tidak bisa diduga. Pola yang sama
   sudah dipakai .edit-delete-button. Skala tekan tidak ditulis ulang karena .home-button:active
   sudah mengurusnya. */
.error-popup-button-bahaya {
    background-image: none;
    background-color: var(--danger);
    color: var(--text-on-fill);
}

.error-popup-button-bahaya:active {
    background-color: var(--danger-strong);
    color: var(--text-on-fill);
}

.edit-page {
    background-color: var(--bg-page);
    background-image: resource('Sprite/Tema/latar-tema-terang');
    -unity-background-scale-mode: scale-and-crop;
    display: flex;
    position: absolute;
    width: 100%;
    height: 100%;
    translate: 100% 0;
    opacity: 1;
    transition-duration: 0.45s;
    transition-timing-function: ease-out-cubic;
}

.show-edit {
    translate: 0 0;
}

.edit-body {
    flex-grow: 1;
