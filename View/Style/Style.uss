.edit-syarat-dropdown {
    flex-grow: 1;
    width: 80%;
}

/* Tinggal satu kolom sejak katalog global dilepas, jadi ditengahkan; space-between akan
   membuatnya menggantung di kiri dengan separuh kartu kosong. */
.narasi-select-columns {
    width: 100%;
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    margin-top: 10px;
}

.narasi-select-column {
    width: 540px;
    flex-shrink: 0;
    align-items: stretch;
}


.narasi-column-title {
    height: 48px;
    flex-shrink: 0;
    color: var(--accent);
    font-size: 36px;
    -unity-text-align: middle-left;
    -unity-font: url("project://database/Assets/Resources/Sprite/300Mind/2D%20Game%20UI%20Kit/Fonts/Ariston%20Comic%20Font.ttf?fileID=12800000&guid=e28e9ad7f0a79f14d8c01971d5416eba&type=3#Ariston Comic Font");
    -unity-font-definition: initial;
    -unity-font-style: normal;
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: var(--accent);
}




.narasi-global-field-label {
    width: 100%;
    height: 36px;
    flex-shrink: 0;
    margin-top: 14px;
    color: var(--accent);
    font-size: 28px;
    -unity-text-align: middle-left;
    -unity-font: url("project://database/Assets/Resources/Sprite/300Mind/2D%20Game%20UI%20Kit/Fonts/Ariston%20Comic%20Font.ttf?fileID=12800000&guid=e28e9ad7f0a79f14d8c01971d5416eba&type=3#Ariston Comic Font");
    -unity-font-definition: initial;
    -unity-text-outline-width: 0.4px;
    -unity-text-outline-color: var(--accent);
}

.narasi-global-dropdown {
    width: 100%;
    height: 66px;
    flex-shrink: 0;
    margin-top: 6px;
    font-size: 44px;
    color: var(--text-on-light);
    background-color: rgba(245, 245, 245, 0);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
    -unity-font-style: normal;
}

/* Dibangun ulang mengikuti .edit-dialog-hint sesudah aturan aslinya tidak sengaja terhapus;
   nilai aslinya tidak tersimpan di mana pun, jadi ini pendekatan, bukan pemulihan persis. */
.narasi-global-hint {
    width: 100%;
    flex-shrink: 0;
    margin-top: 10px;
    color: var(--text-muted);
    font-size: 28px;
    white-space: normal;
    -unity-text-align: upper-left;
    -unity-font: resource('Sprite/300Mind/2D Game UI Kit/Fonts/Ariston Comic Font');
    -unity-font-definition: initial;
}



